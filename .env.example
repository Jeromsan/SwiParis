# Set this in PowerShell: $env:GOOGLE_MAPS_API_KEY = 'your-browser-key'
# This file is documentation, not loaded automatically.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
SWIPARIS_CATALOG=data/processed/common.sqlite
SWIPARIS_LOGS=data/pilot/interactions.sqlite
SWIPARIS_PORT=8000
SWIPARIS_API_URL=http://127.0.0.1:8000
# Versioned trained prior registry used by the API.
SWIPARIS_MODELS_DIR=models
# Legacy fallback if no versioned model is registered.
SWIPARIS_PRIOR_W0=
SWIPARIS_MODEL_VERSION=
